NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=*

# MongoDB
MONGO_URL=mongodb://localhost:27017/chat

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_TTL=1d

# Redis (optional). When enabled, Socket.IO uses the Redis adapter so multiple
# server instances share rooms/broadcasts, and presence is stored in Redis.
# When disabled, a single instance keeps everything in memory.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Anti-spam: max messages per user per window over WebSocket
MESSAGE_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_MS=10000

# HTTP rate limiting (Redis store when enabled)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
